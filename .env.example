# 应用基础配置
APP_ENV=production
APP_NAME=wecom-ai-assistant
APP_VERSION=0.1.0
LOG_LEVEL=INFO
APP_PORT=8000
TZ=Asia/Shanghai
DEFAULT_TENANT_SLUG=default-tenant
DEFAULT_TENANT_NAME=默认企业

# 数据库 / 缓存（生产环境必须通过安全渠道覆盖真实凭证）
DATABASE_URL=mysql+asyncmy://wecom_ai:CHANGE_ME_PASSWORD@mysql:3306/wecom_ai?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
MYSQL_DATABASE=wecom_ai
MYSQL_USER=wecom_ai
MYSQL_PASSWORD=CHANGE_ME_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# LLM（留空则使用 FakeLLMProvider，仅建议测试环境使用）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_AUTH_MODE=bearer
LLM_SEND_TEMPERATURE=true
LLM_TIMEOUT_SECONDS=15
AI_BRIDGE_TOKEN=

# Embedding（留空则使用 HashEmbeddingProvider；这是非 RAG/非生产占位能力）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 企业微信微信客服（真实凭证不得提交仓库；回调必须是公网 HTTPS）
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_TOKEN=
WECOM_RECEIVE_ID=
WECOM_ENCODING_AES_KEY=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_HTTP_TIMEOUT_SECONDS=10

# Wechaty WorkPro Bridge（第三方 Puppet Service；真实 Token 不得提交仓库）
WECHATY_PUPPET_SERVICE_TOKEN=
WECHATY_PUPPET_SERVICE_AUTHORITY=token-service-discovery-test.juzibot.com
AI_API_BASE_URL=http://app:8000
BRIDGE_MESSAGE_TIMEOUT_MS=20000
BRIDGE_API_MAX_RETRIES=1
BRIDGE_REPLY_MAX_LENGTH=500
BRIDGE_MAX_MESSAGE_AGE_SECONDS=180
BRIDGE_CONTACT_WHITELIST=
WORKPRO_AUTO_ACCEPT_FRIENDSHIP=false
WORKPRO_STAFF_USERID=

# 兼容旧命名：若历史环境仍使用 WECOM_SECRET / WECOM_AES_KEY，应用也会继续读取
# WECOM_SECRET=
# WECOM_AES_KEY=

# RAG / AI 行为
HANDOFF_CONFIDENCE_THRESHOLD=0.35
SENSITIVE_KEYWORDS=退款纠纷,投诉,起诉,律师
RETRIEVAL_TOP_K=5
BRIDGE_CHAT_HISTORY_LIMIT=12

# 回访任务：默认关闭自动发送，需人工审核后才允许发送
REVISIT_AUTO_SEND_ENABLED=false
