# 应用基础配置
APP_ENV=development
APP_NAME=wecom-ai-assistant
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# 数据库 / 缓存（本地开发默认值，生产环境必须替换为真实凭证并通过安全渠道注入）
DATABASE_URL=postgresql+psycopg://localhost:5432/wecom_ai
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=wecom_ai

# LLM（OpenAI-compatible，留空则使用内置 FakeLLMProvider，便于本地开发/测试）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15

# Embedding（OpenAI-compatible，留空则使用内置 HashEmbeddingProvider）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 企业微信（占位，真实凭证不得提交仓库；见 docs/deployment.md 安全建议）
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# RAG / AI 行为
HANDOFF_CONFIDENCE_THRESHOLD=0.35
SENSITIVE_KEYWORDS=退款纠纷,投诉,起诉,律师
RETRIEVAL_TOP_K=5

# 回访任务：默认关闭自动发送，需人工审核后才允许发送
REVISIT_AUTO_SEND_ENABLED=false
