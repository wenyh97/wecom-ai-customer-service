{
  "name": "wechaty-workpro-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Wechaty WorkPro bridge for wecom-ai-customer-service",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <24"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint src tests",
    "start": "node dist/src/index.js",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.13.5",
    "@juzi/wechaty": "1.0.166",
    "@juzi/wechaty-puppet-service": "1.0.129",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "26.5.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
